# Supabase — obtener en app.supabase.com > Ajustes > Claves API
# URL base del proyecto (sin /rest/v1/)
NEXT_PUBLIC_SUPABASE_URL=
# Clave publicable (sb_publishable_...) — segura para el navegador (protegida por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave secreta (sb_secret_...) — SOLO servidor. NUNCA commitear ni exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sistema. La usa el destino del enlace del correo de
# recuperación de contraseña. Si falta, el código cae a la URL de producción.
NEXT_PUBLIC_SITE_URL=https://gestionlab.skardiam.com

# Correos que administran la plataforma, separados por coma. Dan acceso a
# /plataforma para dar de alta y suspender laboratorios. Si falta o está vacía,
# nadie tiene ese acceso. No lleva NEXT_PUBLIC_: el navegador no debe verla.
SUPERADMIN_EMAILS=
